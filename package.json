{
  "name": "fauchar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev --turbopack\" \"node --watch server/index.js\"",
    "dev:web": "next dev --turbopack",
    "dev:api": "node --watch server/index.js",
    "build": "next build --turbopack",
    "start": "next start",
    "start:api": "node server/index.js",
    "lint": "eslint",
    "test": "npm run test:intake && npm run test:margin && npm run test:workflow && npm run test:cad && npm run test:teeth && npm run test:mesh",
    "test:intake": "node --test scripts/test-intake.mjs",
    "test:margin": "node --test scripts/test-margin.mjs",
    "test:workflow": "node --test scripts/test-workflow.mjs",
    "test:cad": "node scripts/test-cad.mjs",
    "test:teeth": "node scripts/test-teeth.mjs",
    "test:mesh": "node --test scripts/test-mesh-quality.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "linkedom": "^0.18.15",
    "typescript": "^5"
  }
}
